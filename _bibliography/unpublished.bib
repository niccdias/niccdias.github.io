@UNPUBLISHED{Dias2025-stable,
  title     = "Don't judge citizens for changing their opinions",
  author    = "Dias, Nicholas C",
  year      = 2026,
  pdf={dias_stability_working.pdf},
  abstract  = "Citizens change their minds about policy issues frequently, and scholars have long worried that this distorts democratic representation: Unstable opinions are assumed to be superficial or detached from citizens' core values and, thus, imply that citizens routinely support policies at odds with what they actually value. I challenge this reasoning. Using panel data from three countries (n > 29,000), I show that value-consistent opinions are only slightly more stable than value-inconsistent ones. Knowing an opinion is stable raises the probability that it is value-consistent by no more than six percentage points. I also argue that this result is theoretically expected: Staying true to one's values can require changing one's opinion, while value-inconsistent opinions can be stabilized by bias or conformity. In short, a dominant indictment of citizen competence and democratic representation — that opinion instability reveals the absence of meaningful preferences — rests on an assumption that does not hold."
}

@UNPUBLISHED{Dias2025-know,
  title     = "Do inequalities in factual policy knowledge matter?",
  author    = "Dias, Nicholas C",
  year      = 2025,
  pdf={dias_know_working.pdf},
  abstract  = "Public opinion is meant to reflect all citizens' values and interests. But some argue that public opinion is not what it seems: Some citizens have more facts than others, enabling them to better translate their abstract principles into concrete policy opinions. Consequently, public opinion over-represents the wishes of these informed citizens. Yet, existing measures of knowledge are incomplete and biased, suggesting that knowledge inequalities may arise because tests focus on facts that are more relevant to certain groups. To overcome these limitations, I propose a novel approach to measuring how citizens understand policies, which examines whether citizens recognize different rationales for policy opinions. Then, in a demographically representative sample of 2,000 U.S. adults, I use this measure to reexamine whether some groups are better equipped to form policy opinions. Contrary to past evidence, I find that citizens with different education, political interest, and values understand policy issues in similar terms."
}

@UNPUBLISHED{Dias2025-exp,
  title     = "Do citizens' policy opinions match their principles?",
  author    = "Dias, Nicholas C",
  year      = 2025,
  pdf={dias_constraint_working.pdf},
  abstract  = "Many scholars argue that citizens’ policy opinions are a poor reflection of their underlying values and interests. This claim is troubling, as it implies citizens may vote against their principles. Yet, existing tests of are likely to underestimate the extent to which citizens form principled opinions. First, these methods cannot account for principles that the researchers did not anticipate. Second, citizens are often asked to evaluate policies whose relation to their principles is undefined. I address these problems with a new method, which examines whether citizens use information about policies’ consequences to align their policy opinions and principles. Then, I demonstrate this approach with a pre-registered experiment, which centers on citizens’ values of distributive justice. I show that citizens broadly prefer policies that distribute benefits according to their distributive values. As such, this article calls on researchers to reexamine their pessimism about whether citizens’ opinions can meaningfully guide government policy."
}
